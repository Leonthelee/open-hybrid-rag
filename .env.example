# Open Hybrid RAG - Gateway Configuration
HOST=127.0.0.1
PORT=8000

# 🔒 Security: Set API_KEY to require authentication on ingest/orchestrate
# Leave empty for open access on localhost only
API_KEY=

# 🛡️ Privacy Mode: "local_only" (strict no-cloud) | "hybrid" (fallback allowed) | "cloud_only"
PRIVACY_MODE=hybrid

# 1. Local Engine (Ollama, LM Studio, vLLM, LocalAI)
# LOCAL_ENGINE_TYPE: "ollama" | "openai_compatible"
LOCAL_ENGINE_TYPE=ollama
LOCAL_LLM_URL=http://127.0.0.1:11434/api/chat
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_EMBED_URL=http://127.0.0.1:11434/api/embeddings
LOCAL_EMBED_MODEL=qwen3-embedding:8b

# 2. Universal Cloud Fallback (Gemini, OpenAI, Anthropic, DeepSeek, Groq)
# Provider options: gemini | openai | anthropic | groq | deepseek
CLOUD_PROVIDER=gemini
CLOUD_API_KEY=
CLOUD_MODEL=gemini-2.0-flash

# 3. Knowledge Base & Second Brain Storage
SECOND_BRAIN_PATH=./knowledge_base

# 4. Mathematical Routing Thresholds
RAG_CERTAINTY_THRESHOLD=0.85
RAG_MIN_THRESHOLD=0.65
