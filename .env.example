# Configuration for Open Hybrid RAG Gateway
PORT=8000
HOST=0.0.0.0

# Local LLM & Embeddings (Agnostic: Ollama, LM Studio, vLLM, etc.)
LOCAL_LLM_URL=http://127.0.0.1:11434/api/chat
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_EMBED_URL=http://127.0.0.1:11434/api/embeddings
LOCAL_EMBED_MODEL=qwen3-embedding:8b

# Cloud Fallback (Google Gemini AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Knowledge Base & Second Brain Path
SECOND_BRAIN_PATH=./knowledge_base

# Thresholds
RAG_CERTAINTY_THRESHOLD=0.85
RAG_MIN_THRESHOLD=0.65
